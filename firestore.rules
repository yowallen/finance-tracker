rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isCreatingOwn() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function canRead() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow read: if canRead();
      allow create: if isCreatingOwn();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /recurringBills/{billId} {
      allow read: if canRead();
      allow create: if isCreatingOwn();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /savingsGoals/{goalId} {
      allow read: if canRead();
      allow create: if isCreatingOwn();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /creditCards/{cardId} {
      allow read: if canRead();
      allow create: if isCreatingOwn();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /savingsPools/{poolId} {
      allow read: if isSignedIn() && request.auth.uid == poolId;
      allow create: if isSignedIn()
        && request.auth.uid == poolId
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && request.auth.uid == poolId
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && request.auth.uid == poolId
        && resource.data.userId == request.auth.uid;
    }
  }
}
